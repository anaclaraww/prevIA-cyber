      "versionNonce": 1642650484,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794432934325,
      "link": null,
      "locked": false,
      "text": "—  Cada sistema externo fica atrás de uma porta: trocar um é trocar o adaptador.",
      "originalText": "—  Cada sistema externo fica atrás de uma porta: trocar um é trocar o adaptador.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
