      "isDeleted": true,
      "boundElements": [],
      "updated": 1794432934325,
      "link": null,
      "locked": false,
      "text": "—  Controllers finos: HTTP e perfil. A regra mora nos serviços, reusados pelo simulador.",
      "originalText": "—  Controllers finos: HTTP e perfil. A regra mora nos serviços, reusados pelo simulador.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
