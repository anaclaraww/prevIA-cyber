      "type": "text",
      "x": 1379.0210701812452,
      "y": 1277.9590863667368,
      "width": 936.32,
      "height": 23.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
