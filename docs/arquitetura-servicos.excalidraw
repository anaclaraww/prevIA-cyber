      "type": "text",
      "x": 1379.0210701812452,
      "y": 1327.9590863667368,
      "width": 851.2,
      "height": 23.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
