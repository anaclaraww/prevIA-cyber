      "versionNonce": 1849844,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794432934325,
      "link": null,
      "locked": false,
      "text": "—  Dependências só apontam para dentro: o domínio não referencia nenhum projeto.",
      "originalText": "—  Dependências só apontam para dentro: o domínio não referencia nenhum projeto.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
