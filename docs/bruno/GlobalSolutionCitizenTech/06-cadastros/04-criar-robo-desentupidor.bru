meta {
  name: Criar robô desentupidor
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/robos
  body: json
  auth: inherit
}

body:json {
  {
    "codigo": "DES-BV-{{sufixo}}",
    "tipo": "Desentupidor",
    "bairroBaseId": "{{novoBairroId}}",
    "bateria": 100
  }
}

script:pre-request {
  bru.setVar("sufixo", Math.floor(Math.random() * 90000) + 10000);
}
