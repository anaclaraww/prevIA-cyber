meta {
  name: Criar bairro
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/bairros
  body: json
  auth: inherit
}

body:json {
  {
    "nome": "Bela Vista {{sufixo}}",
    "cidade": "São Paulo",
    "uf": "SP",
    "latitude": -23.5614,
    "longitude": -46.6559,
    "limiarChuvaMm": 25
  }
}

script:pre-request {
  bru.setVar("sufixo", Math.floor(Math.random() * 90000) + 10000);
}

script:post-response {
  bru.setVar('novoBairroId', res.getBody().id);
}

tests {
  test('201', () => expect(res.getStatus()).to.equal(201));
}
