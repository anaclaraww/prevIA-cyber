meta {
  name: Obter token (Sensor)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/token
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{sensorId}}",
    "clientSecret": "{{sensorSecret}}"
  }
}

vars:pre-request {
  sensorId: sensor-gateway
  sensorSecret: sensor-gateway-demo-2026
}

script:post-response {
  bru.setVar('tokenSensor', res.getBody().accessToken);
}

tests {
  test('200', () => expect(res.getStatus()).to.equal(200));
  test('perfil Sensor', () => expect(res.getBody().perfil).to.eql('Sensor'));
}
