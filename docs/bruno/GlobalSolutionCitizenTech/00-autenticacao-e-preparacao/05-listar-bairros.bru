meta {
  name: Listar bairros
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/bairros
  body: none
  auth: inherit
}

script:post-response {
  const pantanal = res.getBody().find(b => b.nome === 'Jardim Pantanal');
  bru.setVar('bairroId', pantanal.id);
}

tests {
  test('200', () => expect(res.getStatus()).to.equal(200));
}
