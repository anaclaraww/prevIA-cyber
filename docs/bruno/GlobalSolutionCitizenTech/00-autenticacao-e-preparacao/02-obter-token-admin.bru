meta {
  name: Obter token (Admin)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/token
  body: json
  auth: none
}

body:json {
  {
    "clientId": "{{adminId}}",
    "clientSecret": "{{adminSecret}}"
  }
}

vars:pre-request {
  adminId: admin
  adminSecret: admin-demo-2026
}

script:post-response {
  bru.setVar('token', res.getBody().accessToken);
}

tests {
  test('200', () => expect(res.getStatus()).to.equal(200));
  test('perfil Admin', () => expect(res.getBody().perfil).to.eql('Admin'));
}
